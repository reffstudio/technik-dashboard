{
  "npm.autoDetect": "off",
  "npm.exclude": "**/node_modules/**,**/.next/**",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.next/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true
  },
  "files.exclude": {
    "**/.next/cache": true,
    "**/.next/server": true,
    "**/.next/static": true,
    "**/.next/dev/cache": true,
    "**/.next/dev/server": true,
    "**/.next/dev/static": true
  },
  "css.lint.unknownAtRules": "ignore",
  "css.lint.vendorPrefix": "ignore",
  "css.lint.unknownVendorSpecificProperties": "ignore",
  "typescript.tsserver.maxTsServerMemory": 1536,
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.watchOptions": {
    "excludeDirectories": ["**/node_modules", "**/.git", "**/.next"]
  }
}
